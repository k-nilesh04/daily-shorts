# Copy to .env for local runs:  set -a; source .env; set +a
GEMINI_API_KEY=
# Only needed for upload
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Gemini API key needs paid-tier billing for AI video generation.
OMNI_API_KEY=
AI_VIDEO_MAX_USD=3.25
DRY_RUN=false

# Content settings (funny 3D character stories & animated comedy)
NICHE=Funny 3D animated short stories with cute characters (cute babies, funny cats, mischievous pets) in entertaining comedy situations
LANGUAGE=Hinglish
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+0%
GEMINI_MODEL=gemini-2.5-flash
TARGET_SECONDS=45

# Video layout ('fullscreen' for 9:16 vertical or 'frame' for centered square)
LAYOUT=fullscreen
HEADER_TITLE=COMEDY SHORTS  /  FUNNY TOONS
HEADER_SUBTITLE=3D ANIMATION  /  ENTERTAINING  /  FUNNY

# YouTube settings (Category 23 = Comedy, 24 = Entertainment)
YT_CATEGORY_ID=23
PRIVACY_STATUS=private
