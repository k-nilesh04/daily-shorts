# Copy to .env for local runs.
#   bash/zsh:             set -a; source .env; set +a
#   PowerShell:           Get-Content .env | ForEach-Object { if ($_ -match '^(.*?)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
GEMINI_API_KEY=
# Only needed for upload
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Choose "gemini" (default) for prompt-generated scenes, or "json2video" explicitly
# for a still-image + title render. Adding JSON2VIDEO_API_KEY alone does NOT switch providers.
VIDEO_PROVIDER=gemini
JSON2VIDEO_API_KEY=
# Required when VIDEO_PROVIDER=json2video: a publicly accessible image URL.
JSON2VIDEO_IMAGE_URL=
# Gemini API key needs paid-tier billing for AI video generation.
OMNI_API_KEY=
# Override the Gemini video model used for scene generation if needed.
OMNI_MODEL=gemini-omni-1.2-flash
# Hugging Face API key (optional, increases rate limits for free inference)
HUGGINGFACE_API_KEY=
# Gmail notifications (leave empty to disable)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Recipient email (defaults to GMAIL_ADDRESS if empty)
NOTIFY_EMAIL=
# Model used for thumbnail generation (Gemini image generation / nano banana).
THUMBNAIL_MODEL=gemini-2.0-flash-exp
AI_VIDEO_MAX_USD=3.25
DRY_RUN=false

# Content settings (funny 3D character stories & animated comedy)
NICHE=Funny 3D animated short stories with cute characters (cute babies, funny cats, mischievous pets) in entertaining comedy situations
LANGUAGE=Hinglish
TTS_VOICE=hi-IN-MadhurNeural
TTS_RATE=+0%
GEMINI_MODEL=gemini-3.1-flash-lite
# Script word counts start from this duration (~2.0 spoken words/second) and adapt to TTS.
TARGET_SECONDS=45

# Video layout ('fullscreen' for 9:16 vertical or 'frame' for centered square)
LAYOUT=fullscreen
SEGMENT_SECONDS=4.5
CAPTION_FONT=DejaVu Sans
CAPTION_SIZE=78
CAPTION_UPPER=false

# YouTube settings (Category 23 = Comedy, 24 = Entertainment)
YT_CATEGORY_ID=23
# private (default), unlisted, or public
PRIVACY_STATUS=private
